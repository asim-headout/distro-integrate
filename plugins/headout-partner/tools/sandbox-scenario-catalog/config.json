{
  "apiBase": "https://www.sandbox-headout.com/api/public/v2",
  "output": "output/scenarios.csv",
  "defaultEarlyExitMatches": 2,
  "scenarios": [
    { "id": "field.semantics.passport", "category": "Checkout Input Fields", "name": "Passport / ID document field (by name/description, not id)", "checker": "hasInputFieldDataType", "params": { "idIncludes": ["PASSPORT", "IDENTITY", "ID DOCUMENT", "ID NUMBER"] } },
    { "id": "field.semantics.dob", "category": "Checkout Input Fields", "name": "Date of Birth field (by name — real sandbox examples encode as dataType STRING, not DATE)", "checker": "hasInputFieldDataType", "params": { "idIncludes": ["DATE OF BIRTH", "DOB"] } },
    { "id": "field.semantics.numeric_as_string", "category": "Checkout Input Fields", "name": "Field with numeric real-world meaning (weight/height) but dataType=STRING, not INT/FLOAT", "checker": "hasInputFieldDataType", "params": { "dataType": "STRING", "idIncludes": ["WEIGHT", "HEIGHT"] } },
    { "id": "field.type.bool", "category": "Checkout Input Fields", "name": "Boolean (waiver/consent) field", "checker": "hasInputFieldDataType", "params": { "dataType": "BOOL" } },
    { "id": "field.type.enum", "category": "Checkout Input Fields", "name": "Enum/dropdown field", "checker": "hasInputFieldDataType", "params": { "dataType": "ENUM" } },
    { "id": "field.type.numeric_bounded", "category": "Checkout Input Fields", "name": "Bounded numeric field (dataType INT/FLOAT with min/max) — rare; most numeric-looking fields are actually STRING, see field.semantics.numeric_as_string", "checker": "hasInputFieldDataType", "params": { "dataType": ["INT", "FLOAT"], "requireValidationKeys": ["minValue", "maxValue"] } },
    { "id": "field.type.location.free_text", "category": "Location Fields", "name": "Free-text LOCATION field", "checker": "hasLocationField", "params": { "predefined": false } },
    { "id": "field.type.location.predefined", "category": "Location Fields", "name": "Predefined/dropdown LOCATION field", "checker": "hasLocationField", "params": { "predefined": true } },
    { "id": "field.type.location.predefined_timed", "category": "Location Fields", "name": "Predefined location with timingConfig window", "checker": "hasLocationField", "params": { "predefined": true, "requireTimingConfig": true } },
    { "id": "field.level.all_customer", "category": "Checkout Input Fields", "name": "Per-traveler (ALL_CUSTOMER) input field", "checker": "hasInputFieldLevel", "params": { "level": "ALL_CUSTOMER" } },
    { "id": "inventory.field_override", "category": "Inventory Overrides", "name": "Inventory-level input fields differ from variant-level default", "checker": "inventoryFieldsDifferFromVariant", "params": {} },
    { "id": "variant.pax.nationality_gated", "category": "Pax/Pack Types", "name": "Nationality-gated pack (e.g. resident/local pricing)", "checker": "hasVariantProperty", "params": { "keyIncludes": ["NATIONALITY"] } },
    { "id": "variant.pricing.per_group", "category": "Pax/Pack Types", "name": "PER_GROUP priced product (vs PER_PERSON)", "checker": "hasPriceProfileType", "params": { "profileType": "PER_GROUP" } },
    { "id": "variant.pax.min_max_nondefault", "category": "Pax/Pack Types", "name": "Non-default min/max pax per booking (booking-level variant.pax, not per-pax-type)", "checker": "hasNonDefaultPaxRange", "params": {} },
    { "id": "variant.pax.per_type_range_bounded", "category": "Pax/Pack Types", "name": "Per-pax-type bounded range (inventory.pricing.persons[].paxRange.max not null) — distinct from variant.pax.min_max_nondefault; confirmed rare across sandbox regardless of inventory date", "checker": "hasNonNullPersonPaxRangeMax", "params": {} },
    { "id": "product.inventory_selection.seatmap", "category": "Seatmap", "name": "Seatmap-selection product (vs NORMAL)", "checker": "hasInventorySelectionType", "params": { "type": "SEATMAP" } },
    { "id": "product.inventory_selection.svg", "category": "Seatmap", "name": "inventorySelectionType=SVG — undocumented third value alongside NORMAL/SEATMAP, found via payload diffing (not in docs)", "checker": "hasInventorySelectionType", "params": { "type": "SVG" } },
    { "id": "catalog.categories.secondary_present", "category": "Catalog Hierarchy", "name": "Product with secondaryCategories populated (multi-category)", "checker": "hasSecondaryCategories", "params": {} },
    { "id": "product.type.transfer", "category": "Product Structuring", "name": "TRANSFER / AIRPORT_TRANSFER product type", "checker": "hasProductType", "params": { "types": ["TRANSFER", "AIRPORT_TRANSFER"] } },
    { "id": "product.variant_count.multi", "category": "Product Structuring", "name": "Product with 3+ variants", "checker": "hasMinVariantCount", "params": { "min": 3 } },
    { "id": "product.confirmation.delayed", "category": "Product Structuring", "name": "Delayed confirmation product (hasInstantConfirmation=false)", "checker": "hasInstantConfirmation", "params": { "value": false } },
    { "id": "variant.cashback.present", "category": "Product Structuring", "name": "Variant with cashback", "checker": "hasCashback", "params": {} },
    { "id": "variant.cancellation.nonrefundable", "category": "Cancellation", "name": "Non-cancellable / non-refundable variant", "checker": "hasCancellationPolicy", "params": { "cancellable": false } },
    { "id": "variant.cancellation.cutoff_window", "category": "Cancellation", "name": "Cancellable-up-to cutoff window variant", "checker": "hasCancellationPolicy", "params": { "cancellable": true, "requireCutoff": true } },

    { "id": "variant.properties.single_value", "category": "Variant Properties", "name": "Variant with non-empty `properties` (single string-valued)", "checker": "hasNonEmptyProperties", "params": {} },
    { "id": "variant.properties.v2_multi_value", "category": "Variant Properties", "name": "Variant with `propertiesV2` multi-value entry (e.g. multi-nationality/language)", "checker": "hasMultiValuePropertiesV2", "params": {} },

    { "id": "field.values_shape.null", "category": "Validation Values Shape", "name": "validation.values = null (no constraint) on a non-LOCATION field", "checker": "hasValidationValuesShape", "params": { "shape": "null" } },
    { "id": "field.values_shape.wrapped_enum", "category": "Validation Values Shape", "name": "validation.values as {type:TEXT, value:[...]} wrapper (ENUM) — only appears on GET /v2/inventories/{id}, never on the Product API", "checker": "hasValidationValuesShape", "params": { "source": "inventory", "dataType": "ENUM", "shape": "wrapped(TEXT)" } },
    { "id": "field.values_shape.wrapped_location", "category": "Validation Values Shape", "name": "validation.values as {type:PREDEFINED_LOCATION, value:[...]} wrapper — only appears on GET /v2/inventories/{id}, never on the Product API", "checker": "hasValidationValuesShape", "params": { "source": "inventory", "dataType": "LOCATION", "shape": "wrapped(PREDEFINED_LOCATION)" } },

    { "id": "field.type.unknown", "category": "Forward Compatibility", "name": "Field with a dataType outside the documented STRING/ENUM/BOOL/INT/FLOAT/LOCATION enum", "checker": "hasUnknownInputFieldDataType", "params": {} },

    { "id": "field.matrix.string.primary_customer", "category": "Field Level x Type Matrix", "name": "STRING field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "STRING", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field.matrix.string.all_customer", "category": "Field Level x Type Matrix", "name": "STRING field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "STRING", "level": "ALL_CUSTOMER" } },
    { "id": "field.matrix.enum.primary_customer", "category": "Field Level x Type Matrix", "name": "ENUM field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "ENUM", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field.matrix.enum.all_customer", "category": "Field Level x Type Matrix", "name": "ENUM field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "ENUM", "level": "ALL_CUSTOMER" } },
    { "id": "field.matrix.bool.primary_customer", "category": "Field Level x Type Matrix", "name": "BOOL field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "BOOL", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field.matrix.bool.all_customer", "category": "Field Level x Type Matrix", "name": "BOOL field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "BOOL", "level": "ALL_CUSTOMER" } },
    { "id": "field.matrix.int.primary_customer", "category": "Field Level x Type Matrix", "name": "INT field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "INT", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field.matrix.int.all_customer", "category": "Field Level x Type Matrix", "name": "INT field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "INT", "level": "ALL_CUSTOMER" } },
    { "id": "field.matrix.float.all_customer", "category": "Field Level x Type Matrix", "name": "FLOAT field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "FLOAT", "level": "ALL_CUSTOMER" } },
    { "id": "field.matrix.location.primary_customer", "category": "Field Level x Type Matrix", "name": "LOCATION field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "LOCATION", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field.matrix.location.all_customer", "category": "Field Level x Type Matrix", "name": "LOCATION field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "LOCATION", "level": "ALL_CUSTOMER" } }
  ]
}
