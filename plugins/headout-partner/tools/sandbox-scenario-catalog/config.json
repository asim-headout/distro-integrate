{
  "apiBase": "https://www.sandbox-headout.com/api/public/v2",
  "output": "output/scenarios.csv",
  "defaultEarlyExitMatches": 2,
  "scenarios": [
    { "id": "input_field_passport", "category": "Checkout Input Fields", "name": "Passport / ID document field (by name/description, not id)", "checker": "hasInputFieldDataType", "params": { "idIncludes": ["PASSPORT", "IDENTITY", "ID DOCUMENT", "ID NUMBER"] } },
    { "id": "input_field_dob", "category": "Checkout Input Fields", "name": "Date of Birth field (by name — real sandbox examples encode as dataType STRING, not DATE)", "checker": "hasInputFieldDataType", "params": { "idIncludes": ["DATE OF BIRTH", "DOB"] } },
    { "id": "input_field_numeric_semantics_as_string", "category": "Checkout Input Fields", "name": "Field with numeric real-world meaning (weight/height) but dataType=STRING, not INT/FLOAT", "checker": "hasInputFieldDataType", "params": { "dataType": "STRING", "idIncludes": ["WEIGHT", "HEIGHT"] } },
    { "id": "input_field_bool", "category": "Checkout Input Fields", "name": "Boolean (waiver/consent) field", "checker": "hasInputFieldDataType", "params": { "dataType": "BOOL" } },
    { "id": "input_field_enum", "category": "Checkout Input Fields", "name": "Enum/dropdown field", "checker": "hasInputFieldDataType", "params": { "dataType": "ENUM" } },
    { "id": "input_field_numeric_bounded", "category": "Checkout Input Fields", "name": "Bounded numeric field (dataType INT/FLOAT with min/max) — rare; most numeric-looking fields are actually STRING, see input_field_numeric_semantics_as_string", "checker": "hasInputFieldDataType", "params": { "dataType": ["INT", "FLOAT"], "requireValidationKeys": ["minValue", "maxValue"] } },
    { "id": "location_free_text", "category": "Location Fields", "name": "Free-text LOCATION field", "checker": "hasLocationField", "params": { "predefined": false } },
    { "id": "location_predefined", "category": "Location Fields", "name": "Predefined/dropdown LOCATION field", "checker": "hasLocationField", "params": { "predefined": true } },
    { "id": "location_time_windowed", "category": "Location Fields", "name": "Predefined location with timingConfig window", "checker": "hasLocationField", "params": { "predefined": true, "requireTimingConfig": true } },
    { "id": "input_level_booking", "category": "Checkout Input Fields", "name": "Booking-level (not per-customer) input field", "checker": "hasInputFieldLevel", "params": { "level": "BOOKING" } },
    { "id": "input_level_all_customer", "category": "Checkout Input Fields", "name": "Per-traveler (ALL_CUSTOMER) input field", "checker": "hasInputFieldLevel", "params": { "level": "ALL_CUSTOMER" } },
    { "id": "inventory_field_override", "category": "Inventory Overrides", "name": "Inventory-level input fields differ from variant-level default", "checker": "inventoryFieldsDifferFromVariant", "params": {} },
    { "id": "paxtype_nationality", "category": "Pax/Pack Types", "name": "Nationality-gated pack (e.g. resident/local pricing)", "checker": "hasVariantProperty", "params": { "keyIncludes": ["NATIONALITY"] } },
    { "id": "pricing_per_group", "category": "Pax/Pack Types", "name": "PER_GROUP priced product (vs PER_PERSON)", "checker": "hasPriceProfileType", "params": { "profileType": "PER_GROUP" } },
    { "id": "pax_min_max_nondefault", "category": "Pax/Pack Types", "name": "Non-default min/max pax per booking", "checker": "hasNonDefaultPaxRange", "params": {} },
    { "id": "seatmap_product", "category": "Seatmap", "name": "Seatmap-selection product (vs NORMAL)", "checker": "hasInventorySelectionType", "params": { "type": "SEATMAP" } },
    { "id": "svg_product", "category": "Seatmap", "name": "inventorySelectionType=SVG — undocumented third value alongside NORMAL/SEATMAP, found via payload diffing (not in docs)", "checker": "hasInventorySelectionType", "params": { "type": "SVG" } },
    { "id": "secondary_categories_present", "category": "Catalog Hierarchy", "name": "Product with secondaryCategories populated (multi-category)", "checker": "hasSecondaryCategories", "params": {} },
    { "id": "product_type_transfer", "category": "Product Structuring", "name": "TRANSFER / AIRPORT_TRANSFER product type", "checker": "hasProductType", "params": { "types": ["TRANSFER", "AIRPORT_TRANSFER"] } },
    { "id": "product_multi_variant", "category": "Product Structuring", "name": "Product with 3+ variants", "checker": "hasMinVariantCount", "params": { "min": 3 } },
    { "id": "instant_confirmation_false", "category": "Product Structuring", "name": "Delayed confirmation product (hasInstantConfirmation=false)", "checker": "hasInstantConfirmation", "params": { "value": false } },
    { "id": "cashback_present", "category": "Product Structuring", "name": "Variant with cashback", "checker": "hasCashback", "params": {} },
    { "id": "cancellation_nonrefundable", "category": "Cancellation", "name": "Non-cancellable / non-refundable variant", "checker": "hasCancellationPolicy", "params": { "cancellable": false } },
    { "id": "cancellation_cutoff_window", "category": "Cancellation", "name": "Cancellable-up-to cutoff window variant", "checker": "hasCancellationPolicy", "params": { "cancellable": true, "requireCutoff": true } },

    { "id": "properties_single_value", "category": "Variant Properties", "name": "Variant with non-empty `properties` (single string-valued)", "checker": "hasNonEmptyProperties", "params": {} },
    { "id": "properties_v2_multi_value", "category": "Variant Properties", "name": "Variant with `propertiesV2` multi-value entry (e.g. multi-nationality/language)", "checker": "hasMultiValuePropertiesV2", "params": {} },

    { "id": "validation_values_null", "category": "Validation Values Shape", "name": "validation.values = null (no constraint) on a non-LOCATION field", "checker": "hasValidationValuesShape", "params": { "shape": "null" } },
    { "id": "validation_values_wrapped_enum", "category": "Validation Values Shape", "name": "validation.values as {type:TEXT, value:[...]} wrapper (ENUM)", "checker": "hasValidationValuesShape", "params": { "dataType": "ENUM", "shape": "wrapped(TEXT)" } },
    { "id": "validation_values_wrapped_location", "category": "Validation Values Shape", "name": "validation.values as {type:PREDEFINED_LOCATION, value:[...]} wrapper", "checker": "hasValidationValuesShape", "params": { "dataType": "LOCATION", "shape": "wrapped(PREDEFINED_LOCATION)" } },

    { "id": "input_field_unknown_datatype", "category": "Forward Compatibility", "name": "Field with a dataType outside the documented STRING/ENUM/BOOL/INT/FLOAT/LOCATION enum", "checker": "hasUnknownInputFieldDataType", "params": {} },

    { "id": "field_matrix_string_primary", "category": "Field Level x Type Matrix", "name": "STRING field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "STRING", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field_matrix_string_all", "category": "Field Level x Type Matrix", "name": "STRING field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "STRING", "level": "ALL_CUSTOMER" } },
    { "id": "field_matrix_string_booking", "category": "Field Level x Type Matrix", "name": "STRING field at BOOKING level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "STRING", "level": "BOOKING" } },
    { "id": "field_matrix_enum_primary", "category": "Field Level x Type Matrix", "name": "ENUM field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "ENUM", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field_matrix_enum_all", "category": "Field Level x Type Matrix", "name": "ENUM field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "ENUM", "level": "ALL_CUSTOMER" } },
    { "id": "field_matrix_enum_booking", "category": "Field Level x Type Matrix", "name": "ENUM field at BOOKING level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "ENUM", "level": "BOOKING" } },
    { "id": "field_matrix_bool_primary", "category": "Field Level x Type Matrix", "name": "BOOL field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "BOOL", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field_matrix_bool_all", "category": "Field Level x Type Matrix", "name": "BOOL field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "BOOL", "level": "ALL_CUSTOMER" } },
    { "id": "field_matrix_bool_booking", "category": "Field Level x Type Matrix", "name": "BOOL field at BOOKING level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "BOOL", "level": "BOOKING" } },
    { "id": "field_matrix_int_primary", "category": "Field Level x Type Matrix", "name": "INT field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "INT", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field_matrix_int_all", "category": "Field Level x Type Matrix", "name": "INT field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "INT", "level": "ALL_CUSTOMER" } },
    { "id": "field_matrix_float_all", "category": "Field Level x Type Matrix", "name": "FLOAT field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "FLOAT", "level": "ALL_CUSTOMER" } },
    { "id": "field_matrix_location_primary", "category": "Field Level x Type Matrix", "name": "LOCATION field at PRIMARY_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "LOCATION", "level": "PRIMARY_CUSTOMER" } },
    { "id": "field_matrix_location_all", "category": "Field Level x Type Matrix", "name": "LOCATION field at ALL_CUSTOMER level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "LOCATION", "level": "ALL_CUSTOMER" } },
    { "id": "field_matrix_location_booking", "category": "Field Level x Type Matrix", "name": "LOCATION field at BOOKING level", "checker": "hasInputFieldDataTypeAndLevel", "params": { "dataType": "LOCATION", "level": "BOOKING" } }
  ]
}
